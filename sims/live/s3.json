% O₂"}}],"segs":[{"t0":0.5,"t1":3.7,"panel":{"kind":"action","eyebrow":"Your action","body":"\"The bronchiolitis in bed 6 has gone bad, please come.\""},"lines":[]},{"t0":3.7,"t1":17.19,"panel":{"kind":"text","eyebrow":"What happens"},"lines":[{"t0":3.7,"t1":5.8,"text":"Which child?"},{"t0":6.18,"t1":8.47,"text":"What is the saturation?"},{"t0":8.85,"t1":16.31,"text":"Is he breathing?\" The intensivist asks you to call back with details; three minutes are lost."}]},{"t0":17.19,"t1":20.47,"panel":{"kind":"decision","eyebrow":"Decision 5 of 5","title":"The situation has changed"},"lines":[{"t0":17.19,"t1":18.99,"text":"What do you do now?"}]}]},"d5o1":{"duration":12.14,"monitorOn":0,"alarm":{"hr":[80,160],"spo2":92,"rr":[16,50]},"vitals":[{"t":0,"v":{"hr":110,"rr":24,"spo2":94,"bp":"92/58","crt":2,"temp":38.0,"avpu":"A","o2":"Bag-mask · 100% O₂"}},{"t":4.5,"v":{"hr":110,"rr":24,"spo2":94,"bp":"92/58","crt":2,"temp":38.0,"avpu":"A","o2":"Bag-mask · 100% O₂"}}],"segs":[{"t0":0.5,"t1":3.7,"panel":{"kind":"action","eyebrow":"Your action","body":"\"Dr Rao, this is Nurse Priya, paediatric ward. Aarav, 3 years, 14 kg, bronchiolitis day 3. Admitted on 2 L prongs; at 1 am severe distress, SpO₂ 90 %, started HFNC 28 L FiO₂ 0.5 and improved. At 3:40 he became drowsy and apnoeic, SpO₂ 82 %, HR 88. We are bag-mask ventilating with 100 % oxygen, SpO₂ now 94 %, HR 110, IV in situ, glucose 5.2. We need you here now for intubation and PICU transfer.\""},"lines":[]},{"t0":3.7,"t1":12.14,"panel":{"kind":"text","eyebrow":"What happens"},"lines":[{"t0":3.7,"t1":10.66,"text":"The intensivist confirms she is coming with the intubation kit and will be there in 5 minutes."}]}]},"d5o2":{"duration":17.32,"monitorOn":0,"alarm":{"hr":[80,160],"spo2":92,"rr":[16,50]},"vitals":[{"t":0,"v":{"hr":110,"rr":24,"spo2":94,"bp":"92/58","crt":2,"temp":38.0,"avpu":"A","o2":"Bag-mask · 100% O₂"}},{"t":4.5,"v":{"hr":110,"rr":24,"spo2":94,"bp":"92/58","crt":2,"temp":38.0,"avpu":"A","o2":"Bag-mask · 100% O₂"}}],"segs":[{"t0":0.5,"t1":3.7,"panel":{"kind":"action","eyebrow":"Your action","body":"\"We've been bagging him, he's pink now, can you decide in the morning?\""},"lines":[]},{"t0":3.7,"t1":14.04,"panel":{"kind":"text","eyebrow":"What happens"},"lines":[{"t0":3.7,"t1":13.16,"text":"In the morning?\" The intensivist asks for numbers; when she hears 'apnoea' she says she is coming now, but minutes are lost in the confusion."}]},{"t0":14.04,"t1":17.32,"panel":{"kind":"decision","eyebrow":"Decision 5 of 5","title":"The situation has changed"},"lines":[{"t0":14.04,"t1":15.84,"text":"What do you do now?"}]}]},"d5o3":{"duration":16.29,"monitorOn":0,"alarm":{"hr":[80,160],"spo2":92,"rr":[16,50]},"vitals":[{"t":0,"v":{"hr":110,"rr":24,"spo2":94,"bp":"92/58","crt":2,"temp":38.0,"avpu":"A","o2":"Bag-mask · 100% O₂"}},{"t":4.5,"v":{"hr":110,"rr":24,"spo2":94,"bp":"92/58","crt":2,"temp":38.0,"avpu":"A","o2":"Bag-mask · 100% O₂"}}],"segs":[{"t0":0.5,"t1":3.7,"panel":{"kind":"action","eyebrow":"Your action","body":"Give the handover to the mother so she can tell the intensivist"},"lines":[]},{"t0":3.7,"t1":13.01,"panel":{"kind":"text","eyebrow":"What happens"},"lines":[{"t0":3.7,"t1":7.53,"text":"The mother, crying, tries to explain on the phone."},{"t0":7.91,"t1":12.13,"text":"The intensivist cannot get the numbers she needs."}]},{"t0":13.01,"t1":16.29,"panel":{"kind":"decision","eyebrow":"Decision 5 of 5","title":"The situation has changed"},"lines":[{"t0":13.01,"t1":14.81,"text":"What do you do now?"}]}]},"end_smooth":{"duration":12.71,"monitorOn":0,"alarm":{"hr":[80,160],"spo2":92,"rr":[16,50]},"vitals":[{"t":0,"v":{"hr":110,"rr":24,"spo2":94,"bp":"92/58","crt":2,"temp":38.0,"avpu":"A","o2":"Bag-mask · 100% O₂"}}],"segs":[{"t0":0.5,"t1":12.71,"panel":{"kind":"end","eyebrow":"What happened next"},"lines":[{"t0":0.5,"t1":7.52,"text":"The intensivist intubates him with you assisting, and he is transferred to PICU stable on the ventilator."},{"t0":7.9,"t1":11.23,"text":"His mother was kept informed throughout."}]}]},"end_detour":{"duration":10.99,"monitorOn":0,"alarm":{"hr":[80,160],"spo2":92,"rr":[16,50]},"vitals":[{"t":0,"v":{"hr":110,"rr":24,"spo2":94,"bp":"92/58","crt":2,"temp":38.0,"avpu":"A","o2":"Bag-mask · 100% O₂"}}],"segs":[{"t0":0.5,"t1":10.99,"panel":{"kind":"end","eyebrow":"What happened next"},"lines":[{"t0":0.5,"t1":9.51,"text":"He is intubated and transferred to PICU, but after a longer period of hypoxaemia; the team watch closely for aspiration and hypoxic injury."}]}]}}}