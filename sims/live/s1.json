":[{"t0":3.7,"t1":5.43,"text":"“How bad is she?"},{"t0":5.81,"t1":13.34,"text":"I am busy in the ward.” Without numbers the call goes into the queue; she is seen 40 minutes later."}]},{"t0":14.22,"t1":17.5,"panel":{"kind":"decision","eyebrow":"EC · Effective communication — team","title":"The situation has changed"},"lines":[{"t0":14.22,"t1":16.02,"text":"What do you do now?"}]}]},"d5o3":{"duration":20.56,"monitorOn":0,"alarm":{"hr":[80,180],"spo2":92,"rr":[16,60]},"vitals":[{"t":0,"v":{"hr":150,"rr":48,"spo2":97,"bp":"—","crt":2,"temp":38.2,"avpu":"A","o2":"O₂ 2 L/min · neb given"}},{"t":4.5,"v":{"hr":170,"rr":64,"spo2":91,"bp":"—","crt":2,"temp":38.2,"avpu":"A","o2":"O₂ 2 L/min · neb given"}}],"segs":[{"t0":0.5,"t1":3.7,"panel":{"kind":"action","eyebrow":"Your action","body":"Write it in the notes and tell the doctor at the next round"},"lines":[]},{"t0":3.7,"t1":17.28,"panel":{"kind":"text","eyebrow":"What happens"},"lines":[{"t0":3.7,"t1":6.59,"text":"No one senior knows about her."},{"t0":6.97,"t1":16.4,"text":"An hour later she is tiring on the trolley: SpO₂ 91 %, RR 64, HR 170."}]},{"t0":17.28,"t1":20.56,"panel":{"kind":"decision","eyebrow":"EC · Effective communication — team","title":"The situation has changed"},"lines":[{"t0":17.28,"t1":19.08,"text":"What do you do now?"}]}]},"d6o0":{"duration":16.39,"monitorOn":0,"alarm":{"hr":[80,180],"spo2":92,"rr":[16,60]},"vitals":[{"t":0,"v":{"hr":150,"rr":48,"spo2":97,"bp":"—","crt":2,"temp":38.2,"avpu":"A","o2":"O₂ 2 L/min · neb given"}},{"t":4.5,"v":{"hr":150,"rr":48,"spo2":97,"bp":"—","crt":2,"temp":38.2,"avpu":"A","o2":"O₂ 2 L/min · HDU"}}],"segs":[{"t0":0.5,"t1":3.7,"panel":{"kind":"action","eyebrow":"Your action","body":"Admit to the paediatric HDU / a monitored ward bed; Move her on oxygen with a pulse oximeter, a nurse escort and her mother with her; Call ahead: the receiving bed has oxygen, suction and a monitor ready"},"lines":[]},{"t0":3.7,"t1":16.39,"panel":{"kind":"text","eyebrow":"What happens"},"lines