,"t1":65.15,"text":"What is your impression?"}]}]},"d1o0":{"duration":18.37,"monitorOn":4.0,"alarm":{"hr":[70,150],"spo2":92,"rr":[16,40]},"vitals":[{"t":0,"v":{"hr":112,"rr":24,"spo2":98,"bp":"98/62","crt":1,"temp":36.9,"avpu":"A","o2":"Room air"}},{"t":4.5,"v":{"hr":112,"rr":24,"spo2":98,"bp":"98/62","crt":1,"temp":36.9,"avpu":"A","o2":"Room air"}}],"segs":[{"t0":0.5,"t1":3.7,"panel":{"kind":"action","eyebrow":"Your action","body":"Stable — PAT normal; minor head injury with a scalp wound"},"lines":[]},{"t0":3.7,"t1":10.22,"panel":{"kind":"text","eyebrow":"What happens"},"lines":[{"t0":3.7,"t1":9.34,"text":"You settle on a reassuring first impression and move to a focused assessment."}]},{"t0":10.22,"t1":18.37,"panel":{"kind":"decision","eyebrow":"I · Intervention","title":"Intervention"},"lines":[{"t0":10.22,"t1":13.78,"text":"He is stable on the PAT, so you have time."},{"t0":14.16,"t1":16.89,"text":"What is your intervention now?"}]}]},"d1o1":{"duration":21.38,"monitorOn":4.0,"alarm":{"hr":[70,150],"spo2":92,"rr":[16,40]},"vitals":[{"t":0,"v":{"hr":112,"rr":24,"spo2":98,"bp":"98/62","crt":1,"temp":36.9,"avpu":"A","o2":"Room air"}},{"t":4.5,"v":{"hr":112,"rr":24,"spo2":98,"bp":"98/62","crt":1,"temp":36.9,"avpu":"A","o2":"Room air"}}],"segs":[{"t0":0.5,"t1":3.7,"panel":{"kind":"action","eyebrow":"Your action","body":"Unstable — neurological: raised intracranial pressure from the head injury"},"lines":[]},{"t0":3.7,"t1":18.1,"panel":{"kind":"text","eyebrow":"What happens"},"lines":[{"t0":3.7,"t1":7.23,"text":"You rush him into the resuscitation bay."},{"t0":7.61,"t1":13.9,"text":"He stops crying when his father speaks to him and starts pulling at the monitor leads."},{"t0":14.28,"t1":17.22,"text":"The team asks why he is there."}]},{"t0":18.1,"t1":21.38,"panel":{"kind":"decision","eyebrow":"D · Detection","title":"The situation has changed"},"lines":[{"t0":18.1,"t1":19.9,"text":"What do you do now?"}]}]},"d1o2":{"duration":18.12,"monitorOn":4.0,"alarm":{"hr":[70,1