ow he wants to sleep."}]},{"t0":36.62,"t1":40.02,"panel":{"kind":"decision","eyebrow":"R · Reassessment","title":"Reassessment"},"lines":[{"t0":36.62,"t1":38.54,"text":"How do you respond?"}]}]},"d2o2":{"duration":17.53,"monitorOn":0,"alarm":{"hr":[70,150],"spo2":92,"rr":[16,40]},"vitals":[{"t":0,"v":{"hr":112,"rr":24,"spo2":98,"bp":"98/62","crt":1,"temp":36.9,"avpu":"A","o2":"Room air"}},{"t":4.5,"v":{"hr":112,"rr":24,"spo2":98,"bp":"98/62","crt":1,"temp":36.9,"avpu":"A","o2":"Room air"}}],"segs":[{"t0":0.5,"t1":3.7,"panel":{"kind":"action","eyebrow":"Your action","body":"Send him straight for a CT head; every head injury with bleeding needs imaging"},"lines":[]},{"t0":3.7,"t1":14.25,"panel":{"kind":"text","eyebrow":"What happens"},"lines":[{"t0":3.7,"t1":8.86,"text":"Radiology asks for the doctor's request and the indication."},{"t0":9.24,"t1":13.37,"text":"You have neither; he waits in the corridor for 30 minutes."}]},{"t0":14.25,"t1":17.53,"panel":{"kind":"decision","eyebrow":"I · Intervention","title":"The situation has changed"},"lines":[{"t0":14.25,"t1":16.05,"text":"What do you do now?"}]}]},"d2o3":{"duration":16.45,"monitorOn":0,"alarm":{"hr":[70,150],"spo2":92,"rr":[16,40]},"vitals":[{"t":0,"v":{"hr":112,"rr":24,"spo2":98,"bp":"98/62","crt":1,"temp":36.9,"avpu":"A","o2":"Room air"}},{"t":4.5,"v":{"hr":112,"rr":24,"spo2":98,"bp":"98/62","crt":1,"temp":36.9,"avpu":"A","o2":"Room air"}}],"segs":[{"t0":0.5,"t1":3.7,"panel":{"kind":"action","eyebrow":"Your action","body":"Give an anti-emetic and paracetamol now so he is comfortable in the queue"},"lines":[]},{"t0":3.7,"t1":13.17,"panel":{"kind":"text","eyebrow":"What happens"},"lines":[{"t0":3.7,"t1":7.25,"text":"Anti-emetic and paracetamol given."},{"t0":7.63,"t1":12.29,"text":"He is comfortable — and if he vomits later, the drug may hide it."}]},{"t0":13.17,"t1":16.45,"panel":{"kind":"decision","eyebrow":"I · Intervention","title":"The situation has changed"},"lines":[{"t0":13.17,"t1":14.97,"text":"What do yo