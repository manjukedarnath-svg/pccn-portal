rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function isAdmin() { return request.auth != null && exists(/databases/$(database)/documents/admins/$(request.auth.uid)); }
    function keep(k) { return request.resource.data.get(k, null) == resource.data.get(k, null); }
    match /users/{uid} {
      allow create: if request.auth != null && request.auth.uid == uid;
      allow read: if request.auth != null && (request.auth.uid == uid || isAdmin());
      // learners sync their own module progress, but never their roles or the workshop record
      // (progress.workshop is written by the PCCN Essentials app with a service account, which bypasses these rules)
      allow update: if request.auth != null && request.auth.uid == uid
                    && keep('roles') && keep('email') && keep('createdAt')
                    && request.resource.data.get('progress', {}).get('workshop', null) == resource.data.get('progress', {}).get('workshop', null);
      // admins flag organisers, reset module progress and record a workshop manually from the admin page
      allow update: if isAdmin() && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['roles', 'progress']);
      allow delete: if false;
    }
    match /admins/{uid} {
      allow read: if request.auth != null && (request.auth.uid == uid || isAdmin());
      // admins add other admins and remove any admin but themselves; the first admin is created in the console
      allow create: if isAdmin();
      allow delete: if isAdmin() && request.auth.uid != uid;
      allow update: if false;
    }
    // enrolment allowlist, keyed by lowercase email: loaded by admins; a learner may read only their own entry
    match /enrolments/{email} {
      allow read: if request.auth != null && (isAdmin() || (request.auth.token.email != null && request.auth.token.email.lower() == email));
      allow write: if isAdmin();
    }
    // site settings and video links: public to read (module pages do not require sign-in), admins write
    match /config/{doc} {
      allow read: if true;
      allow write: if isAdmin();
    }
    // Competency self-assessment — OPEN to any nurse (anonymous auth), read/verify by admins only.
    match /competency/{docId} {
      allow create: if request.auth != null
                    && request.resource.data.uid == request.auth.uid
                    && request.resource.data.name is string
                    && request.resource.data.name.size() > 1
                    && request.resource.data.email is string
                    && request.resource.data.declaredTotal is number
                    && request.resource.data.declaredTotal >= 12
                    && request.resource.data.declaredTotal <= 36;
      allow read, update: if request.auth != null && exists(/databases/$(database)/documents/admins/$(request.auth.uid));
      // a signed-in learner may read her own submissions (My Courses queries where email == her sign-in email)
      allow read: if request.auth != null && request.auth.token.email != null && resource.data.email == request.auth.token.email;
      allow delete: if false;
    }
  }
}
